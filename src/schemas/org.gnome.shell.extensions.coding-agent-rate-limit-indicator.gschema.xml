<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="coding-agent-rate-limit-indicator">
  <schema id="org.gnome.shell.extensions.coding-agent-rate-limit-indicator"
          path="/org/gnome/shell/extensions/coding-agent-rate-limit-indicator/">

    <!-- Refresh interval in seconds -->
    <key name="refresh-interval" type="i">
      <default>1800</default>
      <range min="900" max="86400"/>
      <summary>Refresh interval</summary>
      <description>How often to fetch usage data, in seconds (900-86400).</description>
    </key>

    <!-- Display mode: text, bar, or both -->
    <key name="display-mode" type="s">
      <default>'text'</default>
      <choices>
        <choice value="text"/>
        <choice value="bar"/>
        <choice value="both"/>
      </choices>
      <summary>Panel display mode</summary>
      <description>How to display usage in the panel: text, bar, or both.</description>
    </key>

    <!-- Panel reset time display: remaining countdown or recovery clock time -->
    <key name="panel-time-display-mode" type="s">
      <default>'remaining'</default>
      <choices>
        <choice value="remaining"/>
        <choice value="recovery"/>
      </choices>
      <summary>Panel time display mode</summary>
      <description>How to display reset time in the panel: remaining or recovery.</description>
    </key>

    <!-- Whether to show provider icons in the panel -->
    <key name="show-provider-icon" type="b">
      <default>true</default>
      <summary>Show provider icons</summary>
      <description>Whether to show provider icons in the top bar.</description>
    </key>

    <!-- Icon style: color or monochrome -->
    <key name="icon-style" type="s">
      <default>'monochrome'</default>
      <choices>
        <choice value="monochrome"/>
        <choice value="color"/>
      </choices>
      <summary>Icon style</summary>
      <description>Icon rendering style: color or monochrome.</description>
    </key>

    <!-- JSON-encoded array of account objects -->
    <key name="accounts-json" type="s">
      <default>'[]'</default>
      <summary>Accounts configuration</summary>
      <description>JSON array of account objects: [{id, provider, name, config}].</description>
    </key>

    <!-- Internal counter bumped when stored credentials change -->
    <key name="credential-revision" type="i">
      <default>0</default>
      <summary>Credential revision</summary>
      <description>Internal counter incremented when stored credentials change.</description>
    </key>

    <!-- IDs of accounts visible in the panel -->
    <key name="visible-account-ids" type="as">
      <default>[]</default>
      <summary>Visible account IDs</summary>
      <description>List of account IDs to display in the panel and menu.</description>
    </key>

    <!-- HTTP proxy URL (empty = no proxy) -->
    <key name="proxy-url" type="s">
      <default>''</default>
      <summary>HTTP proxy URL</summary>
      <description>Optional HTTP proxy URL for API requests. Leave empty for direct connection.</description>
    </key>

  </schema>
</schemalist>
